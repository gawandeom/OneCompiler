generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Sumission {
  id     String @id @default(uuid())
  code   String
  lang   String
  status Status @default(processing)
  output String @default("")
  error  String? 
}

enum Status {
  processing
  failure
  sucess
}
