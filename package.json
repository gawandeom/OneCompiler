{
  "name": "test",
  "private": true,
  "scripts": {
    "build": "bun run db:generate && turbo run build",
    "dev": "bun run db:generate && turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "bun run db:generate && turbo run check-types",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run --cwd packages/db migrate:dev",
    "db:deploy": "bun run --cwd packages/db migrate:deploy",
    "db:studio": "bun run --cwd packages/db studio"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.7",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.12"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@types/redis": "^4.0.11",
    "bullmq": "^6.0.9",
    "ioredis": "^6.0.0"
  }
}
