generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Submission {
  id     String @id @default(uuid())
  code   String
  lang   String
  status Status @default(processing)
  output String @default("")
  error  String?
}

enum Status {
  processing
  failure
  sucess
}
